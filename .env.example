# Public URL of this app. The Discogs OAuth callback is APP_URL/auth/discogs/callback.
APP_URL=http://localhost:3000

# From https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Identifies this app to the Discogs API.
DISCOGS_USER_AGENT=VinylLibrary/0.1 +http://localhost:3000

# Encrypts the sign-in cookie. 32 random bytes, base64-encoded: openssl rand -base64 32
# Changing it signs everyone out.
TOKEN_ENCRYPTION_KEY=

# Optional: automatic Spotify album matching. Without these, paste album links in the player.
# Create an app at https://developer.spotify.com/dashboard (no OAuth callback needed).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=NL
